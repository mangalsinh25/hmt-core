<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SalesInvoiceLine_Details" pageWidth="595" pageHeight="842" columnWidth="585" leftMargin="10" rightMargin="0" topMargin="0" bottomMargin="0" uuid="ee710912-4310-4633-915a-259063c88438">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Bakery B Idempiere Database"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="RECORD_ID" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT invl.linetotalamt as TaxableAmount, prd.customstariffnumber as HSNCode,
SUM((invl.linenetamt * tax.rate) / 100) AS taxamt,tax.rate as Taxrate,
(
        SELECT SUM(taxamt)
        FROM (
            SELECT (invl.linenetamt * tax.rate) / 100 AS taxamt
            FROM adempiere.c_invoiceline invl
            INNER JOIN adempiere.m_product prd ON invl.m_product_id = prd.m_product_id
            INNER JOIN adempiere.c_tax tax ON invl.c_tax_id = tax.c_tax_id
            WHERE invl.c_invoice_id = $P{RECORD_ID}
        ) AS subquery
    ) AS SumOfTax,
    (
        SELECT SUM(netamttotal.linenetamt)
        FROM adempiere.c_invoiceline netamttotal
        WHERE netamttotal.c_invoice_id = $P{RECORD_ID}
    ) AS Sumofnettotal
	FROM adempiere.c_invoiceline invl
INNER JOIN adempiere.m_product prd ON invl.m_product_id  = prd.m_product_id 
INNER JOIN adempiere.c_tax tax ON invl.c_tax_id = tax.c_tax_id
WHERE invl.c_invoice_id = $P{RECORD_ID}
GROUP by invl.linetotalamt, prd.customstariffnumber, tax.rate

]]>
	</queryString>
