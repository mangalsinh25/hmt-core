	<property name="net.sf.jasperreports.print.create.bookmarks" value="true"/>
	<parameter name="RECORD_ID" class="java.lang.Integer"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["reports/invoice"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT documentno, dateinvoiced, org.name AS orgname, oi.phone, oi.email, l.address1, l.address2, l.city,  inv.c_invoice_id,
	bp.name AS bpname, bp.taxid, bpl.phone AS bpphone, bl.address1 AS bpaddress1,
	bl.address2 AS bpaddress2, bl.postal AS bppincode, bl.city AS bpcity , bankaccount.accountno, bankaccount."name" as accountname,
	bank."name"  as bankname, bank.swiftcode as ifscode, inv.grandtotal as GrandTotal, banklocation.city as bankbranch
FROM
    adempiere.c_invoice inv
INNER JOIN
    adempiere.ad_org org ON inv.ad_org_id  = org.ad_org_id 
INNER JOIN
    adempiere.ad_orginfo oi ON org.ad_org_id  = oi.ad_org_id
INNER JOIN
    adempiere.c_location l ON oi.c_location_id = l.c_location_id
INNER JOIN
    adempiere.c_bpartner bp ON inv.c_bpartner_id = bp.c_bpartner_id
INNER JOIN
    adempiere.c_bpartner_location bpl ON bp.c_bpartner_id = bpl.c_bpartner_id
INNER JOIN
    adempiere.c_location bl ON bpl.c_location_id = bl.c_location_id
INNER JOIN
adempiere.c_bank bank ON org.ad_org_id = bank.ad_org_id 
INNER JOIN
adempiere.c_bankaccount bankaccount ON bank.c_bank_id  = bankaccount.c_bank_id AND bankaccount.isdefault = 'Y'
INNER JOIN
 adempiere.c_location banklocation ON banklocation.c_location_id = bank.c_location_id  

WHERE
    inv.c_invoice_id = $P{RECORD_ID}   
GROUP by documentno, dateinvoiced, org.name, oi.phone, oi.email, l.address1, l.address2, l.city, inv.c_invoice_id,
bp.name, bp.taxid, bpl.phone, bl.address1, bl.address2, bl.postal, bl.city, bankaccount.accountno, bankaccount.name,
bank.name, bank.swiftcode , banklocation.city]]>
	</queryString>
