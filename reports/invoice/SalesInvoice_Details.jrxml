<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SalesInvoice_Details" pageWidth="595" pageHeight="842" columnWidth="578" leftMargin="17" rightMargin="0" topMargin="0" bottomMargin="5" uuid="fd93d601-ac20-4032-8575-ca15329746a8">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Bakery B Idempiere Database"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="RECORD_ID" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    ROW_NUMBER() OVER (ORDER BY invl.qtyinvoiced, invl.pricelist) AS row_num,
    invl.qtyinvoiced,
    invl.pricelist,
    invl.priceactual,
    invl.linetotalamt,
    prd."name",
    prd.customstariffnumber,
    tax.rate,
    invl.linenetamt AS total,
    SUM((invl.linenetamt * tax.rate) / 100) AS taxamt,
    (
        SELECT SUM(taxamt)
        FROM (
            SELECT (invl.linenetamt * tax.rate) / 100 AS taxamt
            FROM adempiere.c_invoiceline invl
            INNER JOIN adempiere.m_product prd ON invl.m_product_id = prd.m_product_id
            INNER JOIN adempiere.c_tax tax ON invl.c_tax_id = tax.c_tax_id
            WHERE invl.c_invoice_id = $P{RECORD_ID}
        ) AS subquery
    ) AS SumOfTax,
    (
        SELECT SUM(totalamttotal.linetotalamt)
        FROM adempiere.c_invoiceline totalamttotal
        WHERE totalamttotal.c_invoice_id = $P{RECORD_ID}
    ) AS Sumoftotal,
    (
        SELECT SUM(netamttotal.linenetamt)
        FROM adempiere.c_invoiceline netamttotal
        WHERE netamttotal.c_invoice_id = $P{RECORD_ID}
    ) AS Sumofnettotal
FROM
    adempiere.c_invoiceline invl
INNER JOIN adempiere.m_product prd ON invl.m_product_id = prd.m_product_id
INNER JOIN adempiere.c_tax tax ON invl.c_tax_id = tax.c_tax_id
WHERE
    invl.c_invoice_id = $P{RECORD_ID}
GROUP BY
    invl.qtyinvoiced,
    invl.pricelist,
    invl.priceactual,
    invl.linetotalamt,
    prd."name",
    prd.customstariffnumber,
    tax.rate,
    invl.linenetamt
]]>
	</queryString>
